# Local env files — only .example templates belong in git.
.env
.env.*
!.env.example
!.env.*.example

# "Website/" is the live site's Next.js source (Vercel project rsg-website)
# and carries its OWN .git, plus node_modules/ and .next/. A nested repo must not
# be tracked by this one — committing it would embed a broken gitlink and sweep in
# build output. It is versioned by its own repo; back that up separately.
# NOTE: this hides it from `git clean -fd`, but NOT from `git clean -fdx`.
/Website/

# Per-developer Claude Code state. settings.local.json holds this machine's
# permission grants; worktrees/ holds checkouts of other branches. Neither is
# shared. (A global ignore covers settings.local.json on this machine only —
# this line is what makes it hold on a fresh clone.)
.claude/settings.local.json
.claude/worktrees/

# Local session memory written by the remember plugin (has its own .gitignore,
# repeated here so the directory stays out even if that file is removed).
/.remember/
