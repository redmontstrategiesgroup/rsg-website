# rsg-nexus — copy to .env and fill in after creating the project.
# See docs/per-app-supabase.md §5 for the create-project runbook.

# Browser-side. The anon key is PUBLISHABLE by design; RLS is what
# enforces isolation. Do not put a service-role key here.
RSG_SUPABASE_URL=https://<project-ref>.supabase.co
RSG_SUPABASE_ANON_KEY=

# Edge-function secrets — set with `supabase secrets set`, NEVER in this file.
#   ANTHROPIC_API_KEY
#   REGISTRY_SYNC_SECRET   (generate a DISTINCT value per app)
#   RSG_APP=nexus
#   RSG_ALLOWED_ORIGIN     (lock CORS down in production)
