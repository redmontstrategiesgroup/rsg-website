# Copy to .env.local and set real values before deploying.

# Secret used to sign session cookies (HMAC). Use a long random string.
# REQUIRED in production — the app refuses to start without it (no fallback).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Admin console credentials. REQUIRED to create the admin account — there are
# no default credentials; without these no admin is seeded (fails closed).
# If data/admins.json already exists from an older seed, delete it and restart
# so the account is re-created from these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Anthropic API key for the site chat assistant (/api/chat).
# Get one at https://platform.claude.com — until it's set, the chat widget
# shows a "not configured" notice and the rest of the site works normally.
ANTHROPIC_API_KEY=

# Optional: override the chat model (defaults to claude-sonnet-5).
# CHAT_MODEL=claude-sonnet-5

# ---- Contact form (app/actions/contact.ts) ----------------------------
# Email notifications via Resend (https://resend.com). Without a key, no
# email is sent but leads are still stored.
RESEND_API_KEY=
# Where lead notifications are delivered (the site owner).
CONTACT_TO_EMAIL=
# Verified sender, e.g. "RSG Website <leads@redmontstrategies.com>".
# Falls back to Resend's onboarding sender for testing if unset.
CONTACT_FROM_EMAIL=

# Optional: durable lead storage in Supabase. Run
# supabase/migrations/001_create_leads.sql first. The service-role key is
# server-only — never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Cloudflare Turnstile spam protection. Both keys required to
# enable the widget (site key is public, secret stays server-side).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: booking calendar (Calendly, Cal.com, etc.). BOOKING_URL is used
# in the auto-reply email; NEXT_PUBLIC_BOOKING_URL powers the thank-you page
# CTA. Usually the same link.
BOOKING_URL=
NEXT_PUBLIC_BOOKING_URL=
