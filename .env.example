# Copy to .env.local and set real values before deploying.

# Canonical public site URL (no trailing slash). Drives the canonical link,
# sitemap.xml, robots.txt, and OpenGraph tags. Defaults to
# https://redmontstrategiesgroup.com if unset — only set this to override.
NEXT_PUBLIC_SITE_URL=https://redmontstrategiesgroup.com

# Demo/sample data (seeded portal clients) for LOCAL DEVELOPMENT ONLY.
# Must stay false (or unset) for production — real users never see fake data.
# Set to true only in local dev if you want the sample portal accounts.
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Secret used to sign session cookies (HMAC). Use a long random string.
# REQUIRED in production — the app refuses to start without it (no fallback).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Admin console credentials. REQUIRED to create the bootstrap owner account —
# there are no default credentials; without these (and no public.admins rows)
# no admin login works (fails closed). Additional admins can be inserted into
# public.admins with hashed passwords and roles; those take precedence by email.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chat provider API key for the site assistant (/api/chat).
# Create a key at https://platform.claude.com — until it's set, the chat
# widget shows a "not configured" notice and the rest of the site works.
ANTHROPIC_API_KEY=

# Optional: override the chat model id (provider default applies if unset).
# CHAT_MODEL=

# Optional: site-wide daily ceiling on chat requests (default 400). The
# assistant politely degrades to the contact form once reached. Per-visitor
# limits (20 per 5 min, 60/day) are fixed in app/api/chat/route.ts.
# CHAT_DAILY_LIMIT=400

# ---- Contact form (app/actions/contact.ts) ----------------------------
# Email notifications via Resend (https://resend.com). Without a key, no
# email is sent but leads are still stored.
RESEND_API_KEY=
# Where lead notifications are delivered (the site owner).
# Defaults to contact@redmontstrategiesgroup.com if unset.
CONTACT_TO_EMAIL=contact@redmontstrategiesgroup.com
# Verified sender, e.g. "RSG Website <contact@redmontstrategiesgroup.com>".
# Falls back to Resend's onboarding sender for testing if unset.
CONTACT_FROM_EMAIL=RSG Website <contact@redmontstrategiesgroup.com>

# Optional: durable lead storage in Supabase. Run
# supabase/migrations/001_create_leads.sql first. The service-role key is
# server-only — never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private dashboard ingestion. Use at least 24 random characters. External
# automations send this as `Authorization: Bearer <secret>` and must also send
# a unique `Idempotency-Key` header. Server-only; never prefix with NEXT_PUBLIC.
BRIEF_INGESTION_SECRET=

# Optional: Cloudflare Turnstile spam protection. Both keys required to
# enable the widget (site key is public, secret stays server-side).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Native scheduling (required for /book). Run
# supabase/migrations/20260714180000_scheduling_platform.sql against your
# Supabase project. Booking writes require Supabase — there is no JSON fallback.
SCHEDULING_TIMEZONE=America/New_York
# Shared secret for Vercel Cron → POST /api/cron/scheduling
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional: durable rate limits across serverless instances (Upstash Redis).
# Without these, the app falls back to in-process limits (fine for single instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Sentry error monitoring. Client DSN may be public; keep auth token server-only.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Deprecated: external Calendly/Cal.com links. The site now uses the native
# /book funnel. These are ignored when native scheduling is configured.
# BOOKING_URL=
# NEXT_PUBLIC_BOOKING_URL=

# Stripe recurring billing for managed services (optional — without these the
# managed-services system runs on manual/invoiced billing and hides online
# payment actions). Webhook endpoint: POST /api/stripe/webhook
# Events to enable: checkout.session.completed, invoice.paid,
# invoice.payment_failed, invoice.finalized, customer.subscription.updated,
# customer.subscription.deleted
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
